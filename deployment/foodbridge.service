[Unit]
Description=FoodBridge Django application
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/winproject-2026s2e/htdocs/2026s2e.winproject.com.au
EnvironmentFile=/home/winproject-2026s2e/htdocs/2026s2e.winproject.com.au/.env
ExecStart=/home/winproject-2026s2e/htdocs/2026s2e.winproject.com.au/venv/bin/gunicorn foodbridge.wsgi:application --bind 0.0.0.0:8096 --workers 3
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target